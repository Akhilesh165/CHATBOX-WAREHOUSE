# ============================================================================
# Environment Configuration for Warehouse Inventory AI Chatbot
# ============================================================================

# Database Connection (SQL Server)
SQL_SERVER=localhost
SQL_DATABASE=WarehouseDB
SQL_USERNAME=wms_chatbot_readonly
SQL_PASSWORD=ChangeThisStrongPassword123!
SQL_DRIVER=ODBC Driver 18 for SQL Server
# Optional full SQLAlchemy URI (overrides individual SQL_* fields if set)
# DATABASE_URL=mssql+pyodbc://wms_chatbot_readonly:ChangeThisStrongPassword123!@localhost/WarehouseDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# LLM Provider Configuration
# Options: "gemini", "openai", "generic_http"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=1

# App & Security Settings
APP_NAME=Warehouse Inventory AI API
DEBUG=False
ADMIN_API_KEY=super-secret-admin-token
SQL_QUERY_TIMEOUT_SEC=30
SQL_MAX_RESULT_ROWS=1000
